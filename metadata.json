    "@type": "Place",
    "name": "Six UN continental aggregates",
    "description": "Africa (UN code 2), Oceania (9), North America (21), Asia (142), Europe (150), Latin America & Caribbean (419)"
  },
  "temporalCoverage": "1995/2022",
